<Window x:Class="WinLanChat.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:WinLanChat.App.Behaviors"
        xmlns:controls="clr-namespace:WinLanChat.App.Controls"
        Title="WinLanChat" Icon="Assets/WinLanChat.ico" Width="1120" Height="780" MinWidth="920" MinHeight="680"
        Background="#10141D" Foreground="#EDF1F7" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" ThemeMode="Dark">
    <Window.Resources>
        <Style x:Key="MessageText" TargetType="RichTextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsDocumentEnabled" Value="True"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SelectionBrush" Value="#347F70"/>
            <Setter Property="IsInactiveSelectionHighlightEnabled" Value="True"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RichTextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Копировать" Command="Copy"
                                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Выделить всё" Command="SelectAll"
                                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#10141D">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="#283142" BorderThickness="0,0,0,1" Background="#171D29" Padding="26,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="11" Background="#67DFC2" Margin="0,0,12,0">
                        <TextBlock Text="W" Foreground="#10241F" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WinLanChat" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Общение в вашей локальной сети" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#222D3C"
                        CornerRadius="14" Padding="12,6">
                    <TextBlock Text="Прямое подключение" Foreground="#B9C7DA" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#171D29" BorderBrush="#283142" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,24">
                        <TextBlock Text="ВАШ КОМПЬЮТЕР" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>
                        <TextBlock Text="{Binding ActiveDisplayName}" FontSize="16" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
                        <Expander Header="Настройки" IsExpanded="{Binding IsSettingsOpen}"
                                  Foreground="{StaticResource MutedBrush}">
                            <StackPanel Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="78"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Имя в чате" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"
                                                 IsEnabled="{Binding CanEditProfile}" AutomationProperties.Name="Имя в чате"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Порт приёма" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"
                                                 IsEnabled="{Binding CanEditProfile}" AutomationProperties.Name="Порт приёма"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="Применить изменения" Command="{Binding ApplyProfileCommand}"
                                        Style="{StaticResource AccentButton}" Margin="0,12,0,0"/>
                                <Button Content="Отменить изменения" Command="{Binding ResetProfileCommand}" Margin="0,8,0,0"
                                        Visibility="{Binding HasProfileChanges, Converter={StaticResource BoolVisibility}}"/>
                                <TextBlock Text="{Binding ProfileHint}" TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                                <CheckBox x:Name="WindowsStartupCheckBox" Margin="0,18,0,0"
                                          IsChecked="{Binding StartWithWindows, Mode=OneWay}"
                                          Command="{Binding ToggleWindowsStartupCommand}"
                                          Foreground="{StaticResource TextBrush}"
                                          AutomationProperties.Name="Запускать вместе с Windows">
                                    <TextBlock Text="Запускать вместе с Windows" TextWrapping="Wrap"/>
                                </CheckBox>
                                <TextBlock Text="При входе в вашу учётную запись. Сохраняется сразу."
                                           TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Expander>
                        <Border Background="#10151F" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Ваш адрес" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding LocalAddresses}" TextWrapping="Wrap" FontSize="12" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <Border Height="1" Background="#2B3445" Margin="0,18"/>
                        <TextBlock Text="КОМПЬЮТЕРЫ В СЕТИ" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                        <Button Content="↻  Обновить список" Command="{Binding RefreshPeersCommand}"/>
                        <TextBlock Text="{Binding DiscoveryStatus}" TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,10,0,12"/>
                        <ListBox ItemsSource="{Binding Peers}" SelectedItem="{Binding SelectedPeer, Mode=TwoWay}"
                                 IsEnabled="{Binding CanEditConnection}" MinHeight="80" MaxHeight="220"
                                 Background="#10151F" BorderThickness="0" Padding="4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 AutomationProperties.Name="Компьютеры в сети">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Foreground" Value="#EDF1F7"/>
                                    <Setter Property="Padding" Value="10,10"/>
                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Shell" CornerRadius="7" Padding="{TemplateBinding Padding}"
                                                        Background="#1B2433" BorderBrush="Transparent" BorderThickness="1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Shell" Property="Background" Value="#283246"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Shell" Property="Background" Value="#21483F"/>
                                                        <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel ToolTip="{Binding Description}">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="Подключиться" Command="{Binding ConnectSelectedCommand}"
                                Style="{StaticResource AccentButton}" Margin="0,12,0,0"/>
                        <Button Content="Отменить подключение" Command="{Binding CancelConnectCommand}" Margin="0,8,0,0"
                                Visibility="{Binding IsConnecting, Converter={StaticResource BoolVisibility}}"/>
                        <Expander Header="Подключение по IP вручную" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0">
                            <StackPanel Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="78"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Адрес собеседника" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding RemoteHost, UpdateSourceTrigger=PropertyChanged}" MaxLength="253"
                                                 IsEnabled="{Binding CanEditConnection}" AutomationProperties.Name="Адрес собеседника"
                                                 ToolTip="Например: 192.168.1.25"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Порт" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"
                                                 IsEnabled="{Binding CanEditConnection}" AutomationProperties.Name="Порт собеседника"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="Подключиться по IP" Command="{Binding ConnectCommand}" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="Запустите WinLanChat на обоих ПК. Выберите компьютер в списке и подключитесь с одной стороны."
                                   TextWrapping="Wrap" FontSize="12" LineHeight="19"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid x:Name="ChatDropTarget" Grid.Column="1" Margin="28,0" Background="Transparent"
                  AllowDrop="True" behaviors:FileDrop.Command="{Binding DropFileCommand}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding PeerName}" FontSize="20" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PeerAddress}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Отключиться" Command="{Binding DisconnectCommand}"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolVisibility}}"/>
                </Grid>

                <Border Grid.Row="1" Background="#3C262D" BorderBrush="#78434F" BorderThickness="1"
                        CornerRadius="8" Padding="12" Margin="0,0,0,12"
                        Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding DismissErrorCommand}"
                                Padding="8,4" Background="Transparent" Margin="8,0,0,0"
                                AutomationProperties.Name="Закрыть сообщение об ошибке"/>
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#F4BEC8"
                                   VerticalAlignment="Center" FontSize="13"/>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="2">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="390" Margin="24">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="72" Height="72" Background="#1D3033" CornerRadius="22" Margin="0,0,0,22">
                            <TextBlock Text="↔" FontSize="38" Foreground="#67DFC2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Разговор начинается здесь" FontSize="23" FontWeight="SemiBold"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="Подключите два компьютера в одной сети и отправьте первое сообщение."
                                   TextAlignment="Center" TextWrapping="Wrap" FontSize="14" LineHeight="23"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0"
                             behaviors:ChatScroll.FollowMessages="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.Name="Переписка">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,8,14"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,12" CornerRadius="12" MaxWidth="520">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#222C3D"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="Margin" Value="0,0,42,0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                    <Setter Property="Background" Value="#21483F"/>
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Margin" Value="42,0,0,0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Author}" FontSize="11" Foreground="#A9BFC5"
                                                   Margin="0,0,0,5" TextTrimming="CharacterEllipsis"/>
                                        <controls:MessageTextBox behaviors:MessageLinks.Text="{Binding Text, Mode=OneWay}"
                                                     Style="{StaticResource MessageText}"
                                                     Visibility="{Binding HasText, Converter={StaticResource BoolVisibility}}"
                                                     AutomationProperties.Name="Текст сообщения в переписке"/>
                                        <Border Background="#18232D" CornerRadius="8" Padding="12" Margin="0,8,0,0"
                                                Visibility="{Binding HasAttachment, Converter={StaticResource BoolVisibility}}">
                                            <StackPanel DataContext="{Binding Attachment}" MinWidth="230" MaxWidth="450">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14"
                                                           TextWrapping="Wrap" ToolTip="{Binding FileName}"/>
                                                <TextBlock Text="{Binding FileSize}" FontSize="11" Foreground="#A9BFC5" Margin="0,4,0,0"/>
                                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,10,0,2"
                                                             Foreground="{StaticResource AccentBrush}" Background="#303B4F"
                                                             Visibility="{Binding IsTransferring, Converter={StaticResource BoolVisibility}}"
                                                             AutomationProperties.Name="Прогресс передачи файла"/>
                                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#B7CBD0"
                                                           TextWrapping="Wrap" Margin="0,7,0,0"/>
                                                <TextBlock Text="{Binding SavedLocation}" FontSize="11" Foreground="#A9BFC5"
                                                           TextWrapping="Wrap" ToolTip="{Binding SavedLocation}"/>
                                                <WrapPanel Margin="0,8,0,0" Visibility="{Binding CanAccept, Converter={StaticResource BoolVisibility}}">
                                                    <Button Content="Сохранить…" Command="{Binding SaveCommand}" Padding="12,7"
                                                            Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
                                                    <Button Content="Отклонить" Command="{Binding RejectCommand}" Padding="12,7"/>
                                                </WrapPanel>
                                                <Button Content="Отменить передачу" Command="{Binding CancelCommand}" Padding="12,7"
                                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolVisibility}}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding Time}" FontSize="10" Foreground="#A9BFC5"
                                                   HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,18,0,18">
                    <ScrollViewer MaxHeight="144" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasDraftAttachment, Converter={StaticResource BoolVisibility}}">
                        <ItemsControl ItemsSource="{Binding DraftAttachments}" AutomationProperties.Name="Прикреплённые файлы">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#222C3D" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕"
                                                    Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Padding="9,5" Margin="12,0,0,0"
                                                    AutomationProperties.Name="Убрать прикреплённый файл"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding FileSize}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" FontSize="12"/>
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}" VerticalAlignment="Center" FontSize="13"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Background="#1A2230" CornerRadius="12" BorderBrush="#303B4F" BorderThickness="1" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="＋" FontSize="23" Command="{Binding AttachFileCommand}" Padding="10,4"
                                    Background="Transparent" VerticalAlignment="Bottom" Margin="0,0,4,0"
                                    ToolTip="Прикрепить файлы или перетащить их в чат" AutomationProperties.Name="Прикрепить файлы"/>
                            <TextBox x:Name="MessageDraftInput" Grid.Column="1" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsConnected}"
                                     behaviors:MessageInput.SendOnEnterCommand="{Binding SendCommand}"
                                     MaxLength="8000" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="58" MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                     Background="#1A2230" BorderBrush="#1A2230" Padding="8,8"
                                     AutomationProperties.Name="Текст сообщения"/>
                            <Button Grid.Column="2" Content="Отправить  →" Command="{Binding SendCommand}"
                                    Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" Margin="12,0,0,0"/>
                        </Grid>
                    </Border>
                    <DockPanel Margin="4,9,4,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DraftCounter}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="Enter — отправить   ·   Shift + Enter — новая строка"
                                   FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </DockPanel>
                </StackPanel>
                <Border Grid.RowSpan="4" Background="#EF1D3033" BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="2" CornerRadius="12" Margin="0,12" IsHitTestVisible="False"
                        Visibility="{Binding ElementName=ChatDropTarget, Path=(behaviors:FileDrop.IsDragOver), Converter={StaticResource BoolVisibility}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <TextBlock Text="Отпустите файлы, чтобы прикрепить" FontSize="20" FontWeight="SemiBold"
                                   TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="До 16 файлов · Отправка после нажатия «Отправить»"
                                   Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#283142" BorderThickness="0,1,0,0" Padding="24,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ConnectionLabel}" FontSize="11"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
